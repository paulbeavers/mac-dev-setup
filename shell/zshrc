# lucent's shell setup for zsh on a Mac: the prompt and aliases of
# extras/macos/bashrc, for the shell macOS uses by default. Nothing
# installs it.
#
# Copy it to ~/.config/zsh/zshrc and load it from ~/.zshrc — zsh reads
# ~/.zshrc for every interactive shell, login or not:
#
#   [[ -f ~/.config/zsh/zshrc ]] && . ~/.config/zsh/zshrc
#
# The tools are optional and each is guarded; to get them all:
#
#   brew install eza bat fd fzf zoxide
#
# git completion needs nothing: zsh ships its own.
#
# macOS keeps a separate history per Terminal window and restores it per
# window, which defeats the shared history set up here. To turn that off,
# in ~/.zshenv (it is read too early for this file to do it):
#
#   SHELL_SESSIONS_DISABLE=1

[[ -o interactive ]] || return 0

# ---- Homebrew --------------------------------------------------------------
#
# Homebrew's installer usually adds this to ~/.zprofile already; this is
# for a machine where it did not. /opt/homebrew on Apple silicon,
# /usr/local on Intel.

if [[ -z ${HOMEBREW_PREFIX:-} ]]; then
    for __lucent_brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x $__lucent_brew ]]; then
            eval "$("$__lucent_brew" shellenv)"
            break
        fi
    done
    unset __lucent_brew
fi

# ---- History ---------------------------------------------------------------

HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY         # a timestamp on each entry; history -i shows it
setopt SHARE_HISTORY            # every shell writes at once and reads the others
setopt HIST_IGNORE_SPACE        # a command starting with a space is not kept
setopt HIST_IGNORE_ALL_DUPS     # a repeated command replaces the older copy
setopt HIST_REDUCE_BLANKS
# No EXTENDED_GLOB: it makes ^ a pattern, and git reset HEAD^ fails.
setopt INTERACTIVE_COMMENTS     # # starts a comment at the prompt too

# ---- Completion ------------------------------------------------------------
#
# Homebrew's packages put their zsh completions in site-functions, which
# has to be on fpath before compinit looks.

if [[ -n ${HOMEBREW_PREFIX:-} && -d $HOMEBREW_PREFIX/share/zsh/site-functions ]]; then
    fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi
# -i skips the "insecure directories" question that Homebrew's
# group-writable directories otherwise raise at every shell.
autoload -Uz compinit && compinit -i
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'     # case-insensitive
zstyle ':completion:*' list-colors ''

# Emacs-style line editing, as in bash, whatever $EDITOR says.
bindkey -e

# ---- Environment -----------------------------------------------------------

if (( $+commands[nvim] )); then
    export EDITOR=nvim VISUAL=nvim
    alias vi=nvim
fi
export LESS='-R -F -i -M'
export VIRTUAL_ENV_DISABLE_PROMPT=1     # the prompt below shows the venv itself
export CLICOLOR=1                       # colour from the BSD ls below

# ---- Aliases ---------------------------------------------------------------

if (( $+commands[eza] )); then
    alias ls='eza --group-directories-first'
    alias ll='eza -l --git --group-directories-first --time-style=long-iso'
    alias la='eza -la --git --group-directories-first --time-style=long-iso'
    alias lt='eza --tree --level=2 --git-ignore'
else
    # BSD ls: -G is colour; --color only exists from macOS 13.
    alias ls='ls -G'
    alias ll='ls -lhG'
    alias la='ls -lhaG'
fi
alias grep='grep --color=auto'
alias ..='cd ..' ...='cd ../..'
alias cl='clear'

alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --oneline --graph --decorate -20'
alias gla='git log --oneline --graph --decorate --all -30'

# ---- fzf and zoxide --------------------------------------------------------

if (( $+commands[fzf] )); then
    if (( $+commands[fd] )); then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
        export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
        export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
    fi
    if (( $+commands[bat] )); then
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
    fi
    # Ctrl-R history, Ctrl-T files, Alt-C directories. fzf --zsh is 0.48+.
    # Alt-C needs "Use Option as Meta key" in Terminal's keyboard settings.
    if __lucent_fzf=$(fzf --zsh 2>/dev/null); then
        eval "$__lucent_fzf"
    elif [[ -n ${HOMEBREW_PREFIX:-} && -f $HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh ]]; then
        . "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
    fi
    unset __lucent_fzf
fi

# z <part of a path> jumps to a directory you have visited; zi picks one.
if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
fi

# ---- Prompt ----------------------------------------------------------------
#
#   user@macbook:~/lucent/config/hypr (main*) ↑1 ❯
#
# In the parentheses with the branch: * for changes not yet committed
# (staged or not), ? for untracked files. After them, ↑/↓ for commits
# ahead of / behind upstream, and any merge, rebase or cherry-pick in
# progress.
#
# PROMPT is rebuilt before each prompt with PROMPT_SUBST off, so zsh does
# not run $(...) in it, and a branch named '$(rm -rf ~)' prints as text.
# % is still special, so the branch and venv names have theirs doubled.

# Sets __lucent_git for the working directory.
__lucent_git_state() {
    __lucent_git=
    local -a lines
    lines=("${(@f)$(git rev-parse --show-toplevel --absolute-git-dir 2>/dev/null)}")
    [[ -n ${lines[1]} ]] || return
    local gitdir=${lines[2]}

    local line head= oid= ahead=0 behind=0 dirty= untracked=
    while IFS= read -r line; do
        case $line in
            ('# branch.oid '*)  oid=${line#'# branch.oid '} ;;
            ('# branch.head '*) head=${line#'# branch.head '} ;;
            ('# branch.ab '*)
                line=${line#'# branch.ab +'}
                ahead=${line%% *}
                behind=${line##*-} ;;
            ('? '*)             untracked=1 ;;
            ([12u]' '*)         dirty=1 ;;
        esac
    done < <(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)

    if [[ $head == '(detached)' ]]; then
        head=${oid[1,7]}
    fi

    local op=
    if [[ -d $gitdir/rebase-merge ]]; then
        op="REBASE $(<"$gitdir/rebase-merge/msgnum")/$(<"$gitdir/rebase-merge/end")"
    elif [[ -d $gitdir/rebase-apply ]]; then
        op=REBASE
    elif [[ -f $gitdir/MERGE_HEAD ]]; then
        op=MERGING
    elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then
        op=CHERRY-PICK
    elif [[ -f $gitdir/REVERT_HEAD ]]; then
        op=REVERTING
    elif [[ -f $gitdir/BISECT_LOG ]]; then
        op=BISECTING
    fi 2>/dev/null

    __lucent_git=" %F{magenta}(${head//\%/%%}%f"
    [[ -n $dirty ]]     && __lucent_git+="%F{yellow}%B*%b%f"
    [[ -n $untracked ]] && __lucent_git+="%F{red}?%f"
    __lucent_git+="%F{magenta})%f"
    (( ahead ))  && __lucent_git+=" %F{cyan}↑$ahead%f"
    (( behind )) && __lucent_git+=" %F{cyan}↓$behind%f"
    [[ -n $op ]] && __lucent_git+=" %F{red}%B$op%b%f"
}

__lucent_prompt() {
    __lucent_git_state

    local venv=
    if [[ -n ${VIRTUAL_ENV:-} ]]; then
        local name=${VIRTUAL_ENV:t}
        venv="%{$(print -n '\e[2m')%}(${name//\%/%%})%{$(print -n '\e[0m')%} "
    fi

    # The window title. %~ is the path with ~ for home.
    print -Pn '\e]0;%~\a'

    # %n is the user name; %(!.#.❯) is # for root and ❯ for anyone else.
    PROMPT="$venv%F{green}%n@$__lucent_host%f:%F{blue}%B%~%b%f$__lucent_git "
    PROMPT+='%F{green}%(!.#.❯)%f '
}

# $HOST on a Mac follows the network and can read 'macbook-pro.lan' one
# day and a DHCP name the next; LocalHostName is the one in Sharing settings.
__lucent_host=$(scutil --get LocalHostName 2>/dev/null) || __lucent_host=
[[ -n $__lucent_host ]] || __lucent_host=${HOST%%.*}
__lucent_host=${__lucent_host//\%/%%}

setopt PROMPT_PERCENT NO_PROMPT_SUBST
# /etc/zshrc_Apple_Terminal adds its own precmd, to tell Terminal the
# working directory for new tabs; add-zsh-hook runs both.
autoload -Uz add-zsh-hook
add-zsh-hook precmd __lucent_prompt
