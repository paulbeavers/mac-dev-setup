# lucent's bash setup, for a Mac: the same prompt and aliases as
# config/bash/bashrc, standing on its own. Nothing installs it.
#
# Copy it to ~/.config/bash/bashrc and load it from ~/.bash_profile, which
# is what Terminal.app and iTerm2 read — they start login shells, and a
# login shell never reads ~/.bashrc by itself:
#
#   [[ -f ~/.config/bash/bashrc ]] && . ~/.config/bash/bashrc
#
# Works with the Mac's own /bin/bash (3.2) and with Homebrew's bash (5.x).
# The tools are optional and each is guarded; to get them all:
#
#   brew install eza bat fd fzf zoxide git bash-completion@2
#
# bash-completion@2 needs bash 4.2 or later; under /bin/bash install
# bash-completion (v1) instead. Either is found below.
#
# macOS keeps a separate history per Terminal window and restores it per
# window, which defeats the shared history set up here. To turn that off:
#
#   touch ~/.bash_sessions_disable

[[ $- == *i* ]] || return 0

# macOS prints "The default interactive shell is now zsh" at every shell.
export BASH_SILENCE_DEPRECATION_WARNING=1

# ---- Homebrew --------------------------------------------------------------
#
# Homebrew's installer adds itself to ~/.zprofile only, so under bash its
# tools are not on PATH until this runs. /opt/homebrew on Apple silicon,
# /usr/local on Intel.

if [[ -z ${HOMEBREW_PREFIX:-} ]]; then
    for __lucent_brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x $__lucent_brew ]]; then
            eval "$("$__lucent_brew" shellenv)"
            break
        fi
    done
    unset __lucent_brew
fi

# ---- PATH ------------------------------------------------------------------
#
# ~/.local/bin first, for tools installed per user (pipx, uv, claude).
# Any copy already on PATH is taken out first, so it moves to the front
# rather than appearing twice, as zsh's typeset -U does.

PATH=":$PATH:"
PATH=${PATH//":$HOME/.local/bin:"/:}
PATH=${PATH#:}
PATH=${PATH%:}
PATH="$HOME/.local/bin${PATH:+:$PATH}"

# ---- History ---------------------------------------------------------------

HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
shopt -s histappend cmdhist
shopt -s checkwinsize extglob cdspell
# bash 4 options; /bin/bash 3.2 refuses them with an error.
if (( BASH_VERSINFO[0] >= 4 )); then
    shopt -s globstar dirspell
fi

# ---- Completion ------------------------------------------------------------

if [[ -n ${HOMEBREW_PREFIX:-} ]]; then
    if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 2) )) &&
       [[ -r $HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh ]]; then
        . "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
    elif [[ -r $HOMEBREW_PREFIX/etc/bash_completion ]]; then
        . "$HOMEBREW_PREFIX/etc/bash_completion"
    fi
fi
# Apple's git ships its completion inside Xcode's tools rather than where
# bash-completion looks. Homebrew's git is found by bash-completion itself.
if ! complete -p git >/dev/null 2>&1; then
    for __lucent_f in \
        /Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash \
        /Applications/Xcode.app/Contents/Developer/usr/share/git-core/git-completion.bash; do
        if [[ -r $__lucent_f ]]; then
            . "$__lucent_f"
            break
        fi
    done
    unset __lucent_f
fi

# ---- Environment -----------------------------------------------------------

if command -v nvim >/dev/null; then
    export EDITOR=nvim VISUAL=nvim
    alias vi=nvim
fi
export LESS='-R -F -i -M'
export VIRTUAL_ENV_DISABLE_PROMPT=1     # the prompt below shows the venv itself
export CLICOLOR=1                       # colour from the BSD ls below

# ---- Aliases ---------------------------------------------------------------

if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first'
    alias ll='eza -l --git --group-directories-first --time-style=long-iso'
    alias la='eza -la --git --group-directories-first --time-style=long-iso'
    alias lt='eza --tree --level=2 --git-ignore'
else
    # BSD ls: -G is colour; --color only exists from macOS 13.
    alias ls='ls -G'
    alias ll='ls -lhG'
    alias la='ls -lhaG'
fi
alias grep='grep --color=auto'
alias ..='cd ..' ...='cd ../..'
alias cl='clear'

alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git log --oneline --graph --decorate -20'
alias gla='git log --oneline --graph --decorate --all -30'

# ---- fzf and zoxide --------------------------------------------------------

if command -v fzf >/dev/null; then
    if command -v fd >/dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
        export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
        export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
    fi
    if command -v bat >/dev/null; then
        export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
    fi
    # Ctrl-R history, Ctrl-T files, Alt-C directories. fzf --bash is 0.48+.
    # Alt-C needs "Use Option as Meta key" in Terminal's keyboard settings.
    if __lucent_fzf=$(fzf --bash 2>/dev/null); then
        eval "$__lucent_fzf"
    elif [[ -n ${HOMEBREW_PREFIX:-} && -f $HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.bash ]]; then
        . "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.bash"
    fi
    unset __lucent_fzf
fi

# z <part of a path> jumps to a directory you have visited; zi picks one.
if command -v zoxide >/dev/null; then
    eval "$(zoxide init bash)"
fi

# ---- Prompt ----------------------------------------------------------------
#
#   user@macbook:~/lucent/config/hypr (main*) ↑1 ❯
#
# In the parentheses with the branch: * for changes not yet committed
# (staged or not), ? for untracked files. After them, ↑/↓ for commits
# ahead of / behind upstream, and any merge, rebase or cherry-pick in
# progress.
#
# PS1 is only ever '${__lucent_ps1}'. Bash expands a variable in PS1 once
# and does not re-read the result, so a branch named '$(rm -rf ~)' prints
# as text. Putting it into PS1 directly would run it. That is also why the
# colours use \001/\002, which work inside a variable, rather than \[ \].

__lucent_c() { printf '\001\033[%sm\002' "$1"; }
__lucent_reset=$(__lucent_c 0)
__lucent_dim=$(__lucent_c 2)
__lucent_bold=$(__lucent_c 1)
__lucent_red=$(__lucent_c 31)
__lucent_green=$(__lucent_c 32)
__lucent_yellow=$(__lucent_c 33)
__lucent_blue=$(__lucent_c 34)
__lucent_magenta=$(__lucent_c 35)
__lucent_cyan=$(__lucent_c 36)
unset -f __lucent_c

# Sets __lucent_path and __lucent_git for the working directory.
__lucent_git_state() {
    __lucent_git=
    local top gitdir
    {
        IFS= read -r top
        IFS= read -r gitdir
    } < <(git rev-parse --show-toplevel --absolute-git-dir 2>/dev/null)

    __lucent_path=$PWD
    if [[ $PWD == "$HOME" || $PWD == "$HOME"/* ]]; then
        __lucent_path="~${PWD#"$HOME"}"
    fi
    __lucent_path=$__lucent_blue$__lucent_bold$__lucent_path$__lucent_reset
    [[ -n $top ]] || return

    local line head= oid= ahead=0 behind=0 dirty= untracked=
    while IFS= read -r line; do
        case $line in
            '# branch.oid '*)  oid=${line#'# branch.oid '} ;;
            '# branch.head '*) head=${line#'# branch.head '} ;;
            '# branch.ab '*)
                line=${line#'# branch.ab +'}
                ahead=${line%% *}
                behind=${line##*-} ;;
            '? '*)             untracked=1 ;;
            [12u]' '*)         dirty=1 ;;
        esac
    done < <(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)

    if [[ $head == '(detached)' ]]; then
        head=${oid:0:7}
    fi

    local op=
    if [[ -d $gitdir/rebase-merge ]]; then
        op="REBASE $(<"$gitdir/rebase-merge/msgnum")/$(<"$gitdir/rebase-merge/end")"
    elif [[ -d $gitdir/rebase-apply ]]; then
        op=REBASE
    elif [[ -f $gitdir/MERGE_HEAD ]]; then
        op=MERGING
    elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then
        op=CHERRY-PICK
    elif [[ -f $gitdir/REVERT_HEAD ]]; then
        op=REVERTING
    elif [[ -f $gitdir/BISECT_LOG ]]; then
        op=BISECTING
    fi 2>/dev/null

    __lucent_git=" $__lucent_magenta($head$__lucent_reset"
    [[ -n $dirty ]]     && __lucent_git+="$__lucent_yellow$__lucent_bold*$__lucent_reset"
    [[ -n $untracked ]] && __lucent_git+="$__lucent_red?$__lucent_reset"
    __lucent_git+="$__lucent_magenta)$__lucent_reset"
    (( ahead ))  && __lucent_git+=" $__lucent_cyan↑$ahead$__lucent_reset"
    (( behind )) && __lucent_git+=" $__lucent_cyan↓$behind$__lucent_reset"
    [[ -n $op ]] && __lucent_git+=" $__lucent_red$__lucent_bold$op$__lucent_reset"
}

__lucent_prompt() {
    __lucent_git_state

    local who="$__lucent_green$__lucent_user@$__lucent_host$__lucent_reset:"
    local venv=
    if [[ -n ${VIRTUAL_ENV:-} ]]; then
        venv="$__lucent_dim(${VIRTUAL_ENV##*/})$__lucent_reset "
    fi
    local mark=❯
    (( EUID == 0 )) && mark='#'

    # The window title.
    local title=${PWD/#"$HOME"/'~'}
    __lucent_ps1=$'\001\033]0;'"$title"$'\a\002'
    __lucent_ps1+="$venv$who$__lucent_path$__lucent_git "
    __lucent_ps1+="$__lucent_green$mark$__lucent_reset "
}

__lucent_user=${USER:-$(id -un)}
# $HOSTNAME on a Mac follows the network and can read 'macbook-pro.lan' one
# day and a DHCP name the next; LocalHostName is the one in Sharing settings.
__lucent_host=$(scutil --get LocalHostName 2>/dev/null) || __lucent_host=
[[ -n $__lucent_host ]] || __lucent_host=${HOSTNAME%%.*}

PS1='${__lucent_ps1}'

# /etc/bashrc_Apple_Terminal sets PROMPT_COMMAND to tell Terminal the
# working directory, for new tabs to open in; it is kept, after this.
if [[ $PROMPT_COMMAND != *__lucent_prompt* ]]; then
    PROMPT_COMMAND="__lucent_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi
